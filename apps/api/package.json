{
    "name": "@repo/api",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "dev": "tsx watch --include \"./src\" ./src/index.ts",
        "build": "tsc && tsc-alias -p tsconfig.json",
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@repo/db": "workspace:*",
        "@repo/errors": "workspace:*",
        "@repo/types": "workspace:*",
        "@repo/validators": "workspace:*",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.21.0",
        "tsc-alias": "^1.8.17",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "25.5.0",
        "@types/supertest": "^7.2.1",
        "@typescript/native-preview": "beta",
        "supertest": "^7.2.2",
        "tsx": "^4.19.0",
        "typescript": "7.0.1-rc",
        "vitest": "^4.1.10"
    }
}
