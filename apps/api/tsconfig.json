{
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./src",
        "paths": {
            "@middleware/*": [
                "./src/middleware/*"
            ],
            "@features/*": [
                "./src/features/*"
            ],
            "@config/*": [
                "./src/config/*"
            ],
        },
        "declaration": false,
        "declarationMap": false,
    },
    "include": [
        "src",
        "src/**/*",
        "../../packages/errors/app-error.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}