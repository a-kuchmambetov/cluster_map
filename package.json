{
    "name": "cluster_map",
    "version": "1.0.0",
    "description": "",
    "keywords": [],
    "license": "ISC",
    "author": "",
    "type": "module",
    "main": "index.js",
    "scripts": {
        "dev": "pnpm -r --parallel dev",
        "start": "pnpm -r --parallel start",
        "start:docs": "pnpm --filter @repo/docs start",
        "build": "pnpm -r --filter '!@repo/docs' build",
        "build:docs": "pnpm --filter @repo/docs build",
        "typecheck": "pnpm -r typecheck",
        "test": "pnpm -r --if-present test",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check"
    },
    "devDependencies": {
        "oxfmt": "^0.59.0",
        "oxlint": "^1.74.0",
        "typescript": "7.0.1-rc"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "26.5.0",
            "onFail": "download"
        },
        "packageManager": {
            "name": "pnpm",
            "version": "11.15.0",
            "onFail": "download"
        }
    }
}
