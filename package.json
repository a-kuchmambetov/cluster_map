{
  "name": "cluster_map",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:docker": "docker compose -f docker-compose.dev.yml up --build",
    "dev:docker:down": "docker compose -f docker-compose.dev.yml --profile simulator down",
    "start": "pnpm -r --parallel start",
    "build": "pnpm -r --filter '!@repo/docs' build",
    "start:docs": "pnpm --filter @repo/docs start",
    "build:docs": "pnpm --filter @repo/docs build",
    "db:up": "docker compose -f docker-compose.dev.yml up -d db",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:seed": "pnpm --filter @repo/db build && pnpm --filter @repo/api db:seed",
    "worker:dev": "pnpm --filter @repo/worker dev",
    "worker:build": "pnpm --filter @repo/worker build",
    "worker:start": "pnpm --filter @repo/worker start",
    "simulator:dev": "pnpm --filter @repo/simulator simulator:dev",
    "simulator:start": "pnpm --filter @repo/simulator simulator",
    "simulator:test": "pnpm --filter @repo/simulator test",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "typescript": "7.0.1-rc"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.5.2",
      "onFail": "download"
    }
  }
}
