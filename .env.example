# This is an example .env file. Copy this file to .env and fill in the values.

# Use a free port on or machine for the API server. This is the port that the API server will listen on.
# Default: 5000
API_PORT=5001

# The origin of the web application. This is used for CORS and other security settings.
# Vite is defaulted to port 5173, but you can change it if you want or need.
WEB_ORIGIN=http://localhost:5173

# Optional frontend API origin (without /api). Leave empty for same-origin requests.
# Local Vite development proxies /api to localhost:API_PORT.
# Production must route /api to the API server or set this before building.
VITE_API_URL=

# PostgreSQL database connection settings. Fill in the values for your database.
# Used for:
# - @repo/db
# - @repo/api
PG_USER=app
PG_DB=app
PG_PASSWORD=app
PG_HOST=localhost
PG_PORT=5432

# Generate a random secret, e.g. openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000
