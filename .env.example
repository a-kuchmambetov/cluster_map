# This is an example .env file. Copy this file to .env and fill in the values.
# Development Docker Compose also runs without .env, using local-only defaults.
# It overrides PG_HOST/PG_PORT inside containers to db:5432 and needs no Infisical.

# Use a free port on or machine for the API server. This is the port that the API server will listen on.
# Default: 5001
API_PORT=5001

# Number of reverse proxies between clients and the API (0 for direct local access).
# Use 1 behind Coolify/Traefik; the API must only be reachable through that proxy.
TRUST_PROXY_HOPS=0

# The origin of the web application. This is used for CORS and other security settings.
# Vite is defaulted to port 5173, but you can change it if you want or need.
WEB_ORIGIN=http://localhost:5173

# Optional frontend API origin (without /api). Leave empty for same-origin requests.
# Docker builds accept VITE_API_URL as a build argument; changing it requires a rebuild.
VITE_API_URL=

# PostgreSQL database connection settings. Fill in the values for your database.
# Used for:
# - @repo/db
# - @repo/api
PG_USER=app
PG_DB=app
PG_PASSWORD=app
PG_HOST=localhost
PG_PORT=5432

# Generate a random secret, e.g. openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5001

# Optional initial administrator account created by apps/worker on first run.
# ADMIN_EMAIL and ADMIN_PASSWORD must both be set or both omitted.
# When they are set, BETTER_AUTH_SECRET and BETTER_AUTH_URL are required.
# ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
# GitHub OAuth credentials.
# Create an OAuth App at https://github.com/settings/developers.
# For local development set the callback URL to:
#   http://localhost:5001/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Simulator (local/demo only). Set SIMULATOR_ENABLED=true after seeding the
# database with pnpm db:seed. Do not enable in production or against a database
# that contains real occupancy data.
# SIMULATOR_ENABLED=false
# SIMULATOR_USER_COUNT=20
# SIMULATOR_INTERVAL_MS=5000
# SIMULATOR_CLAIM_PROBABILITY=0.7
# SIMULATOR_RELEASE_PROBABILITY=0.3
# SIMULATOR_LOCK_KEY=7269736
