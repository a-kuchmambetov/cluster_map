# This is an example .env file. Copy this file to .env and fill in the values.

# Use a free port on or machine for the API server. This is the port that the API server will listen on.
# Default: 5001
API_PORT=5001

# The origin of the web application. This is used for CORS and other security settings.
# Vite is defaulted to port 5173, but you can change it if you want or need.
WEB_ORIGIN=http://localhost:5173

# Optional frontend API origin (without /api). Leave empty for same-origin requests.
# Docker builds accept VITE_API_URL as a build argument; changing it requires a rebuild.
VITE_API_URL=

# PostgreSQL database connection settings. Fill in the values for your database.
# Used for:
# - @repo/db
# - @repo/api
PG_USER=app
PG_DB=app
PG_PASSWORD=app
PG_HOST=localhost
PG_PORT=5432

# Generate a random secret, e.g. openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5001

# Optional initial administrator account created by apps/worker on first run.
# ADMIN_EMAIL and ADMIN_PASSWORD must both be set or both omitted.
# When they are set, BETTER_AUTH_SECRET and BETTER_AUTH_URL are required.
# ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
# GitHub OAuth credentials.
# Create an OAuth App at https://github.com/settings/developers.
# For local development set the callback URL to:
#   http://localhost:5001/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
